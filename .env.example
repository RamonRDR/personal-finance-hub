# The public synthetic demo works without credentials.
APP_TIME_ZONE=America/Sao_Paulo
GOOGLE_INTEGRATION_ENABLED=false

# Only configure these in private server-side hosting secrets.
# Never commit real identifiers, OAuth credentials or tokens.
APP_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAIL=
FINANCE_SPREADSHEET_ID=
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
# Dedicated Upstash Redis database for short-lived, encrypted server sessions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
